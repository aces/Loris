msgid "Data Release"
msgstr "データリリース"

msgid "File Name"
msgstr "ファイル名"

msgid "Version"
msgstr "バージョン"

msgid "Upload Date"
msgstr "アップロード日"

msgid "Project Name"
msgstr "プロジェクト名"

msgid "Data Release ID"
msgstr "データリリースID"

msgid "Upload File"
msgstr "ファイルをアップロード"

msgid "Upload a New File"
msgstr "新しいファイルをアップロードする"

msgid "Add Permission"
msgstr "権限の追加"

msgid "Manage Permissions"
msgstr "権限の管理"

msgid "Note"
msgstr "注記"

msgid "Version names will be saved as lowercase."
msgstr "バージョン名は小文字で保存されます"

msgid "You must select a file to upload"
msgstr "アップロードするファイルを選択する必要があります"

msgid "You must select a project"
msgstr "プロジェクトを選択する必要があります"

msgid "File size exceeds the maximum allowed"
msgstr "ファイルサイズが最大許容サイズを超えています"

msgid "Error"
msgstr "エラー"

msgid "Upload error!"
msgstr "アップロードエラー"

msgid "A file with this name already exists!"
msgstr "この名前のファイルは既に存在します。"

msgid "Would you like to overwrite existing file?"
msgstr "既存のファイルを上書きしますか?"

msgid "Note that the version associated with the file will also be overwritten."
msgstr "ファイルに関連付けられたバージョンも上書きされることに注意してください。"

msgid "Choose a specific file or an entire release below"
msgstr "以下の特定のファイルまたはリリース全体を選択してください"

msgid "Data Release File"
msgstr "データリリースファイル"

msgid "OR"
msgstr "それとも"

msgid "Data Release Version"
msgstr "データリリースバージョン"

msgid "Permission Update Success!"
msgstr "権限の更新に成功しました!"

msgid "Remove Permission"
msgstr "権限を削除する"

msgid "Modify Hidden File Status"
msgstr "隠しファイルのステータスを変更する"

msgid "Unhide Release File"
msgstr "リリースファイルの非表示を解除"

msgid "Hide Release File"
msgstr "リリースファイルを非表示にする"

msgid "Delete File"
msgstr "ファイルを削除する"

msgid "Delete Release File"
msgstr "リリースファイルを削除する"

msgid "Submission Error!"
msgstr "送信エラー!"

msgid "You must select a user!"
msgstr "ユーザーを選択する必要があります。"

msgid "You must select a file OR a version to grant permission on!"
msgstr "権限を付与するには、ファイルまたはバージョンを選択する必要があります"

msgid "Manage Versions a User has access to"
msgstr "ユーザーがアクセスできるバージョンを管理する"

msgid "Search for a User"
msgstr "ユーザーを検索"

msgid "Versions"
msgstr "バージョン"

msgid "Manage Users with access to a Version"
msgstr "バージョンへのアクセス権を持つユーザーを管理する"

msgid "Users"
msgstr "ユーザー"

msgid "Search for a Version"
msgstr "バージョンを検索"

msgid "An error occurred when loading the form!"
msgstr "フォームの読み込み中にエラーが発生しました"

msgid "Manage File"
msgstr "ファイルの管理"

msgid "Unversioned"
msgstr "バージョンなし"

msgid "Hidden By ID"
msgstr "ID により非表示"

msgid "Missing action"
msgstr "アクションが指定されていません"

msgid "Invalid action"
msgstr "無効なアクション"

msgid "No data was sent in the POST request"
msgstr "POST リクエストでデータが送信されませんでした。"

msgid "Missing user to grant access to"
msgstr "アクセス権を付与するユーザーが指定されていません。"

msgid "Must select either specific file OR version to grant access to"
msgstr "アクセス権を付与するには、特定のファイルまたはバージョンを選択する必要があります。"

msgid "No valid data was sent in the request"
msgstr "有効なデータがリクエストで送信されませんでした。"

msgid "Missing user to remove access from"
msgstr "アクセス権を削除するユーザーが指定されていません。"

msgid "Must select a specific file"
msgstr "特定のファイルを選択する必要があります。"

msgid "Can not upload duplicate file"
msgstr "重複したファイルはアップロードできません。"

msgid "Permission denied."
msgstr "アクセス権がありません。"

msgid "Overwrite failed. A file of this name already exists which you do not have permission to overwrite."
msgstr "上書きに失敗しました。同じ名前のファイルが既に存在しており、それを上書きする権限がありません。"

msgid "Can not upload duplicate file."
msgstr "重複したファイルはアップロードできません。"

msgid "Not found"
msgstr "見つかりません"

msgid "Only you, and system administrators will be able to see this file!"
msgstr "このファイルは、あなたとシステム管理者のみが閲覧できます。"

msgid "Anyone with permission to this file will be able to see it."
msgstr "このファイルへのアクセス権を持つユーザーは閲覧できます。"

msgid "This will permanently delete the file from the system!"
msgstr "この操作により、ファイルはシステムから完全に削除されます。"

msgid "File Successfully hidden"
msgstr "ファイルを非表示にしました"

msgid "File Successfully unhidden"
msgstr "ファイルを再表示しました"

msgid "File Successfully deleted"
msgstr "ファイルを削除しました"

msgid "Yes, hide it!"
msgstr "はい、非表示にします！"

msgid "Yes, unhide it!"
msgstr "はい、再表示します！"

msgid "Yes, delete it!"
msgstr "はい、削除します！"
